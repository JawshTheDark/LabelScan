# Copy to .env and fill in. Keep .env out of git (see .gitignore).

# MinIO object storage (holds the scan images)
MINIO_ROOT_USER=labelscan
MINIO_ROOT_PASSWORD=change-me-long-random
MINIO_BUCKET=labelscan

# Host ports (change if something already uses these on the box).
# MinIO's S3 API is internal-only; only the console is published.
MINIO_CONSOLE_PORT=9101
PB_PORT=8090
